// api.yes-chef.win: licensing (one subscription per head device) and remote backups.
// Deploy: npx wrangler deploy --config api/wrangler.jsonc
// Secrets (wrangler secret put --config api/wrangler.jsonc NAME):
//   LICENSE_PRIVATE_KEY   ECDSA P-256 private JWK that signs licenses (public half in js/license-key.js)
//   BACKUP_MASTER_KEY     base64, 32 bytes; per-account backup keys are derived from it
//   GOOGLE_SERVICE_ACCOUNT  service-account JSON with access to the Play Developer API
//   RTDN_SECRET           shared secret in the Pub/Sub push URL for Play notifications
{
  "name": "yes-chef-api",
  "main": "src/index.js",
  "compatibility_date": "2026-10-01",
  "routes": [{"pattern": "api.yes-chef.win", "custom_domain": true}],
  "workers_dev": false,
  "d1_databases": [{"binding": "DB", "database_name": "yes-chef", "database_id": "b3ef59f9-beaa-45a4-9c14-e8e900b8c102", "migrations_dir": "migrations"}],
  "r2_buckets": [{"binding": "BACKUPS", "bucket_name": "yes-chef-backups"}],
  "vars": {
    "ALLOWED_ORIGINS": "https://app.yes-chef.win,https://amelia-mowers.github.io",
    "PLAY_PACKAGE_NAME": "win.yeschef.app",
    "TEST_PURCHASES": "false"
  },
  "env": {
    // Local development and tests: fake Play purchases ("test-active-…"), localhost allowed.
    "dev": {
      "d1_databases": [{"binding": "DB", "database_name": "yes-chef-dev", "database_id": "local", "migrations_dir": "migrations"}],
      "r2_buckets": [{"binding": "BACKUPS", "bucket_name": "yes-chef-backups-dev"}],
      "vars": {
        "ALLOWED_ORIGINS": "http://localhost:8091,http://localhost:8080",
        "PLAY_PACKAGE_NAME": "win.yeschef.app",
        "TEST_PURCHASES": "true"
      }
    }
  },
  "observability": {"enabled": true}
}
